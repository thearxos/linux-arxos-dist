# /usr/lib/udev/rules.d/zz-arxos-ioscheduler.rules — sane per-device I/O schedulers.
# NVMe is fast + deep-queued -> no scheduler; SATA/virtio SSD -> mq-deadline; spinning -> bfq.
# This keeps arx's extract-heavy writes from head-of-line blocking interactive I/O.
# Shipped with linux-arxos, applied live by its install.sh via `udevadm trigger` (no reboot).
ACTION=="add|change", KERNEL=="nvme[0-9]*", ATTR{queue/scheduler}="none"
ACTION=="add|change", KERNEL=="sd[a-z]|vd[a-z]", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="mq-deadline"
ACTION=="add|change", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"
